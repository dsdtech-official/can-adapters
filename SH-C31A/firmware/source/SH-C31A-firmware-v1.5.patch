+	ob.OptionType = OPTIONBYTE_USER;
+	ob.USERType   = OB_USER_nSWBOOT0 | OB_USER_nBOOT0 | OB_USER_nBOOT1;
+	ob.USERConfig = (enable ? OB_BOOT0_FROM_PIN : OB_BOOT0_FROM_OB) | OB_nBOOT0_SET | OB_BOOT1_SYSTEM;
