+#if defined(CONFIG_SH_C31A_V15)
+/* Answer GS_USB_BREQ_GET_STATE (GS_CAN_FEATURE_GET_STATE, bit 13).
+ *
+ * The host uses this to poll bus state and the two error counters on demand,
+ * instead of waiting for the firmware to push an error frame on the next state
+ * transition. Without it a host that attaches to an already-bad bus sees
+ * nothing until something changes.
+ *
+ * Reading the FDCAN registers while the channel is closed is meaningless --
+ * HAL_FDCAN_GetProtocolStatus() reports whatever the peripheral last latched,
+ * and we have measured exactly that kind of garbage on another board
+ * (txerr=192 from a stopped channel). So a closed channel
+ * is reported as STOPPED with both counters zeroed, which is what the enum is
+ * for, rather than passing stale register contents up to the host.
+ *
+ * The ordering below is the same one can_parse_error_status() already uses for
+ * pushed error frames, so polled and pushed state cannot disagree.
+ */
+void can_get_device_state(can_data_t *hcan, struct gs_device_state *state)
+{
+	if (!can_is_enabled(hcan)) {
+		state->state = GS_CAN_STATE_STOPPED;
+		state->rxerr = 0;
+		state->txerr = 0;
+		return;
+	}
+
+	FDCAN_ProtocolStatusTypeDef status = {0};
+	FDCAN_ErrorCountersTypeDef counters = {0};
+
+	can_get_error_status(hcan, &status, &counters);
+
+	if (status.BusOff) {
+		state->state = GS_CAN_STATE_BUS_OFF;
+	} else if (status.ErrorPassive) {
+		state->state = GS_CAN_STATE_ERROR_PASSIVE;
+	} else if (status.Warning) {
+		state->state = GS_CAN_STATE_ERROR_WARNING;
+	} else {
+		state->state = GS_CAN_STATE_ERROR_ACTIVE;
+	}
+
+	state->rxerr = counters.RxErrorCnt;
+	state->txerr = counters.TxErrorCnt;
+}
+#endif
