+#define BOOT0_PINOP_DISABLE    5       // same values as ElmueSoft's ePinOperation
+#define BOOT0_PINOP_ENABLE     6
+#define BOOT0_PINST_ENABLED    0x0002  // same bit as ElmueSoft's PINST_Enabled
+#define BOOT0_PINST_PENDING    0x0100  // ours: differs from what this power cycle booted with
+
