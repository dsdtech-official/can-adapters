diff --git a/src/device/device_g4.c b/src/device/device_g4.c
index 4c73f06..20ebaba 100644
--- a/src/device/device_g4.c
+++ b/src/device/device_g4.c
@@ -98,7 +98,30 @@ void device_sysclock_config(void) {
 	RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
 	RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSI;
 	RCC_OscInitStruct.PLL.PLLM = RCC_PLLM_DIV4;
+	/*
+	 * PLLN sets SYSCLK, and with APB1CLKDivider = DIV1 and
+	 * FdcanClockSelection = PCLK1 below it sets the FDCAN kernel clock too.
+	 *
+	 * HSI16 / PLLM(4) = 4 MHz into the PLL:
+	 *   PLLN 80 -> VCO 320 MHz -> PLLR /2 -> 160 MHz   (this fork's default)
+	 *   PLLN 85 -> VCO 340 MHz -> PLLR /2 -> 170 MHz   (what the SH-C31A ships with)
+	 *
+	 * 340 MHz is inside the G4 VCO range (96..344 MHz) and 170 MHz is the
+	 * part's maximum SYSCLK. Both prerequisites for running there are already
+	 * set above and below: PWR_REGULATOR_VOLTAGE_SCALE1_BOOST and
+	 * FLASH_LATENCY_8.
+	 *
+	 * This is guarded because device_g4.c is shared with BOARD_CANable_MKS2_Pro,
+	 * whose config.h still declares 160 MHz -- changing the PLL for everyone
+	 * would leave that board running at a speed it does not report, which is
+	 * exactly the bug being fixed here. CONFIG_CLK170_SH_C31A moves the clock
+	 * and the two constants in config.h together, or none of them.
+	 */
+#if defined(CONFIG_CLK170_SH_C31A)
+	RCC_OscInitStruct.PLL.PLLN = 85;
+#else
 	RCC_OscInitStruct.PLL.PLLN = 80;
+#endif
 	RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
 	RCC_OscInitStruct.PLL.PLLQ = RCC_PLLQ_DIV2;
 	RCC_OscInitStruct.PLL.PLLR = RCC_PLLR_DIV2;
