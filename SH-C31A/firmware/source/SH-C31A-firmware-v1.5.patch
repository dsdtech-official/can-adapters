+void boot0_service(bool usb_configured, bool can_open)
+{
+	// the write stalls the CPU for ~25 ms: never with a bus running
+	if (can_open) {
+		return;
+	}
+
+	int8_t pending = boot0_pending;
+	if (pending >= 0) {
+		boot0_pending = -1;
+		boot0_window_open = (pending == 1);
+		// always written, even when unchanged, so the host exercises the real path
+		boot0_write(pending == 1);
+		return;
+	}
