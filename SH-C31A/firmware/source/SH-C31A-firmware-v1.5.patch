+static bool boot0_booted_enabled;
+static volatile int8_t boot0_pending = -1; // -1 none, 0 disable, 1 enable
+static bool boot0_window_open;             // host re-enabled the pin: the policy leaves it alone
+#if !defined(CONFIG_BOOT0_MANUAL_ONLY)
