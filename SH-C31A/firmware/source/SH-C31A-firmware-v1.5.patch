+#if defined(CONFIG_BOOT0_DEFAULT_OFF_SH_C31A)
+/*
+ * SH-C31A: PB8 is both BOOT0 and CAN_RXD, so an idle (recessive) bus holds
+ * BOOT0 high at every reset and the board can drop into the ROM bootloader on
+ * its own. The option bytes can make the chip ignore the pin (nSWBOOT0 = 0,
+ * nBOOT0 = 1: always boot main flash). This firmware keeps it that way and
+ * lets the host re-enable the pin for exactly one power cycle, which is how a
+ * firmware update gets in (SW1 to BOOT, then power the board up).
+ *
+ * The chip only loads the option bytes at power-on, so every write below takes
+ * effect from the NEXT power cycle, not the current one.
+ */
