+	uint32_t now = HAL_GetTick();
+	if (boot0_configured_since == 0) {
+		boot0_configured_since = now ? now : 1;
+		return;
+	}
+	if (now - boot0_configured_since < BOOT0_POLICY_DELAY_MS) {
+		return;
+	}
+
+	boot0_policy_done = true;
+	if (boot0_pin_enabled()) {
+		boot0_write(false);
+	}
+#else
+	(void)usb_configured;
+#endif
+}
