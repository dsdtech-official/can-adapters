+	bool ok = HAL_FLASH_Unlock() == HAL_OK && HAL_FLASH_OB_Unlock() == HAL_OK;
+	if (ok) {
+		ok = HAL_FLASHEx_OBProgram(&ob) == HAL_OK; // ~25 ms, the CPU stalls on flash meanwhile
+	}
+	HAL_FLASH_OB_Lock();
+	HAL_FLASH_Lock();
