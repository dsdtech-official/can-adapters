+bool boot0_pin_enabled(void);          // what the option bytes say now
+bool boot0_pin_enabled_at_boot(void);  // what this power cycle actually booted with
+void boot0_request(bool enable);       // from USB context: queue a change for boot0_service()
+void boot0_service(bool usb_configured, bool can_open); // main loop: do the queued / policy write
+#endif
